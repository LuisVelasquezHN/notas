{
  "expo": {
    "name": "Notas",
    "slug": "notas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.novotechn.notas",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.novotechn.notas",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E0A100",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "Notas usa tus fotos para adjuntar imágenes a las notas.",
          "cameraPermission": "Notas usa la cámara para adjuntar fotos a las notas."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Notas usa el micrófono para grabar notas de voz.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-quick-actions",
      "expo-asset",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": ["es", "en"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Notas usa Face ID para desbloquear la app y las notas bloqueadas."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    }
  }
}
