{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": { "simulator": true }
    },
    "development-device": {
      "extends": "development",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "preview", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": { "buildType": "apk" }
    },
    "e2e-test": {
      "withoutCredentials": true,
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "e2e", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": { "EXPO_PUBLIC_APP_ENV": "production" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "metadataPath": "./store.config.json"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
