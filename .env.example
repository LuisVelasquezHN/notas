# Copia este fichero a .env.local (no se sube a git) y rellénalo. Ver store/README.md §0.
# Sin las variables de Supabase la app funciona solo en local (sin sección de cuenta).

# Supabase → Project Settings → API: "Project URL" y la clave "publishable" (o la "anon" antigua).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Opcional: enlace al APK de Android (página de la build de EAS). Aparece en Ajustes en la web.
EXPO_PUBLIC_ANDROID_APK_URL=

# Opcional: informes de errores (Sentry).
EXPO_PUBLIC_SENTRY_DSN=
